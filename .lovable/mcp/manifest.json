  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ppgplyitwqhakveqvqac.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "zaad1",
      "version": "0.1.0",
      "title": "Zaad1"
