        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_transactions",
        "title": "Recent transactions",
        "description": "Read up to 100 of your latest cloud-synced transactions, optionally filtered by type.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Maximum transactions (1–100).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "type": {
              "default": "all",
              "description": "Transaction type to include.",
              "type": "string",
              "enum": [
                "all",
                "income",
                "expense",
                "goal"
              ]
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
